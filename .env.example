# ==============================================================================
# Google Cloud Arcade Solutions - Environment Configuration Template
# Copy this file to .env and customize for your active lab session
# ==============================================================================

# Google Cloud Project Configuration
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-xx-xxxx
DEVSHELL_PROJECT_ID=qwiklabs-gcp-xx-xxxx
CLOUDSDK_CORE_PROJECT=qwiklabs-gcp-xx-xxxx

# Primary Regional Placement
CLOUDSDK_COMPUTE_REGION=us-central1
CLOUDSDK_COMPUTE_ZONE=us-central1-a
LAB_REGION=us-central1
LAB_ZONE=us-central1-a

# User & Identity
GCP_USER_EMAIL=student-xx-xxxx@qwiklabs.net
SECONDARY_USER_EMAIL=student-xx-yyyy@qwiklabs.net

# Optional Service Credentials (if running outside Cloud Shell)
GOOGLE_APPLICATION_CREDENTIALS=
DMS_MIGRATION_PASSWORD=
CLOUDSQL_POSTGRES_PASSWORD=
